# Copy this file to .env for local development (the real .env is gitignored).
# On Render, set these as Environment Variables in the dashboard instead of
# committing a .env file.

# Postgres connection string.
# Local dev: point this at your own Postgres (e.g. a free Neon database).
# Render: use the "Internal Connection String" from your Render Postgres
# instance if the web service and database are in the same Render account,
# or let render.yaml wire it up automatically (see fromDatabase below).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Secret used to sign JWTs. Any long random string works locally; on Render
# let render.yaml generate one for you (see generateValue below).
JWT_SECRET="replace-with-a-long-random-string"

# Optional, defaults to 3000. Render sets this automatically in production.
PORT=3000
